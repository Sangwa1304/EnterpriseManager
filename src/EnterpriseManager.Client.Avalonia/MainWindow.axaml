<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EnterpriseManager.Client.Avalonia.MainWindow"
        Width="960" Height="640"
        MinWidth="360" MinHeight="560"
        Title="EnterpriseManager">
  <Grid RowDefinitions="Auto,*" Margin="28">
    <StackPanel Spacing="8">
      <TextBlock Text="EnterpriseManager" FontSize="28" FontWeight="Bold" />
      <TextBlock Text="Gestion d’entreprise, centralisée et sécurisée."
                 FontSize="14" Opacity="0.72" />
    </StackPanel>
    <Border Grid.Row="1" Margin="0,28,0,0" Padding="24"
            CornerRadius="12" BorderThickness="1"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <StackPanel Spacing="14" VerticalAlignment="Center">
        <TextBlock Text="Connexion au serveur" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="L’application se connecte au serveur central de votre entreprise. Aucune donnée métier n’est disponible lorsque le serveur est hors ligne."
                   TextWrapping="Wrap" MaxWidth="560" />
        <TextBlock Text="Le parcours de connexion sera activé après l’implémentation du service d’identité et des sessions."
                   TextWrapping="Wrap" Opacity="0.72" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
